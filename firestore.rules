rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staff(rid) {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.restaurantId == rid
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['owner','kitchen','waiter'];
    }
    function owner(rid) { return staff(rid) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'owner'; }
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /restaurants/{rid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if owner(rid)
        && request.resource.data.keys().hasOnly(['name','nameHi','acceptingOrders','openingTime','closingTime'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.nameHi is string && request.resource.data.nameHi.size() <= 120
        && request.resource.data.acceptingOrders is bool
        && request.resource.data.openingTime is string && request.resource.data.openingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.closingTime is string && request.resource.data.closingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.openingTime != request.resource.data.closingTime;
      allow delete: if false;
      match /menu/{id} {
        allow read: if true;
        allow create, update: if owner(rid)
          && id.matches('^[a-zA-Z0-9_-]{1,80}$')
          && request.resource.data.keys().hasOnly(['name','nameHi','description','descriptionHi','category','categoryHi','pricePaise','veg','available','emoji'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.nameHi is string && request.resource.data.nameHi.size() <= 120
          && request.resource.data.description is string && request.resource.data.description.size() <= 500
          && request.resource.data.descriptionHi is string && request.resource.data.descriptionHi.size() <= 500
          && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 80
          && request.resource.data.categoryHi is string && request.resource.data.categoryHi.size() <= 80
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16
          && request.resource.data.pricePaise is int && request.resource.data.pricePaise > 0 && request.resource.data.pricePaise <= 1000000
          && request.resource.data.veg is bool && request.resource.data.available is bool;
        allow delete: if false;
      }
      match /tables/{id} {
        allow read: if true;
        allow create, update: if owner(rid) && id.matches('^[1-9][0-9]{0,2}$')
          && request.resource.data.keys().hasOnly(['active']) && request.resource.data.active is bool;
        allow delete: if false;
      }
      match /orders/{id} {
        allow read: if staff(rid) || (signedIn() && resource.data.customerUid == request.auth.uid);
        allow write: if false;
      }
    }
  }
}
