{
  "name": "quickdine-v2",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/domain.test.js tests/saas-domain.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-quickdine \"node --test tests/firestore.test.js\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-quickdine \"node --test --test-concurrency=1 tests/integration.test.js tests/saas.integration.test.js\"",
    "test:browser": "playwright test",
    "test:live-browser": "firebase emulators:exec --only auth,firestore --project demo-quickdine \"node tests/helpers/run-live-browser.js\"",
    "test:demo": "playwright test --config playwright.demo.config.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "firebase": "^11.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.51.1",
    "@vitejs/plugin-react": "^4.6.0",
    "firebase-tools": "^14.27.0",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
